# Environment Variables for LLM MLOps Project

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Storage
GCS_BUCKET_NAME=your-llm-mlops-bucket
DATA_PATH=gs://your-bucket/data
MODEL_PATH=gs://your-bucket/models

# Model Configuration
MODEL_NAME=chat-completion-llm
MODEL_VERSION=v1
MAX_LENGTH=2048
VOCAB_SIZE=50257

# Training
BATCH_SIZE=4
LEARNING_RATE=2e-5
NUM_EPOCHS=3
MAX_STEPS=10000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4

# Monitoring
WANDB_PROJECT=llm-mlops
MLFLOW_TRACKING_URI=https://your-mlflow-server.com
PROMETHEUS_PORT=9090

# Development
PYTHONPATH=/app
LOG_LEVEL=INFO
DEBUG=false